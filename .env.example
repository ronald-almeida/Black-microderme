# Configure no painel da Vercel. Nunca use prefixos PUBLIC para segredos.
QUANTUMPAY_API_KEY=
QUANTUMPAY_API_SECRET=
# Secret retornado pelo cadastro do webhook. Opcional para polling.
QUANTUMPAY_WEBHOOK_SECRET=
# URL de postback validada pela QuantumPay (mTLS ou skip-mTLS aprovado).
# Não preencha antes de habilitar/configurar a assinatura para postbacks.
QUANTUMPAY_POSTBACK_URL=
# Blob privado conectado ao projeto (variável injetada pela Vercel).
BLOB_READ_WRITE_TOKEN=
# Alternativamente, Blob com OIDC: BLOB_STORE_ID, injetado pela Vercel.
# Segredo aleatório com pelo menos 32 caracteres para a sessão do checkout.
CHECKOUT_SESSION_SECRET=
APP_URL=https://black-microderme.vercel.app
