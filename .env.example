# Configure diretamente na Vercel (Production). Nunca use prefixos PUBLIC.
# Chave privada fire_sk_live_... para geração e consulta de Pix.
FIREBOT_API_KEY=
# Opcional: segredo de assinatura configurado no webhook da Firebot.
# O polling do checkout funciona sem webhook.
FIREBOT_WEBHOOK_SECRET=
# Blob privado por OIDC, normalmente injetado pela Vercel.
BLOB_STORE_ID=
# Alternativa ao OIDC; deixe vazio se BLOB_STORE_ID estiver configurado.
BLOB_READ_WRITE_TOKEN=
# Opcional: segredo estável de pelo menos 32 caracteres para as sessões.
# Sem esta variável, a chave da sessão deriva da FIREBOT_API_KEY.
CHECKOUT_SESSION_SECRET=
# Origem HTTPS enviada no storeUrl exigido pela Firebot.
APP_URL=https://black-microderme.vercel.app
